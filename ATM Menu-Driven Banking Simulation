balance = 5000
transactions = []

daily_withdrawal_limit = 10000
daily_withdrawn = 0

while True:
    print("\n===== ATM MENU =====")
    print("1. Balance Inquiry")
    print("2. Deposit Money")
    print("3. Withdraw Money")
    print("4. Transaction Summary")
    print("5. Exit")

    choice = input("Enter your choice: ")

    if choice == "1":
        print("Available Balance: Rs.", balance)

    elif choice == "2":
        amount = float(input("Enter deposit amount: "))

        if amount <= 0:
            print("Invalid deposit amount!")
        elif amount > 50000:
            print("Deposit limit exceeded!")
        else:
            balance += amount
            transactions.append(("Deposit", amount))
            print("Amount deposited successfully.")
            print("Updated Balance: Rs.", balance)

    elif choice == "3":
        amount = float(input("Enter withdrawal amount: "))

        if amount <= 0:
            print("Invalid withdrawal amount!")
        elif amount > balance:
            print("Insufficient balance!")
        elif daily_withdrawn + amount > daily_withdrawal_limit:
            print("Daily withdrawal limit exceeded!")
        else:
            balance -= amount
            daily_withdrawn += amount
            transactions.append(("Withdrawal", amount))
            print("Please collect your cash.")
            print("Remaining Balance: Rs.", balance)

    elif choice == "4":
        print("\n===== TRANSACTION SUMMARY =====")
        if len(transactions) == 0:
            print("No transactions available.")
        else:
            total_deposit = 0
            total_withdrawal = 0

            for transaction, amount in transactions:
                print(transaction, ": Rs.", amount)

                if transaction == "Deposit":
                    total_deposit += amount
                else:
                    total_withdrawal += amount

            print("Total Deposits: Rs.", total_deposit)
            print("Total Withdrawals: Rs.", total_withdrawal)
            print("Current Balance: Rs.", balance)

    elif choice == "5":
        print("Thank you for using our ATM!")
        break

    else:
        print("Invalid choice! Please select 1 to 5.") 

